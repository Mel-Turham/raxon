# Demo credentials for the auth simulation (maquette only, not real secrets).
NEXT_PUBLIC_TEST_EMAIL="demo@raxon.app"
NEXT_PUBLIC_TEST_PASSWORD="DemoPass&2025"
# Public site URL (used for canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL="https://raxon.melturham.me"

# Binance public market data (no key). Also called from the browser for live prices.
NEXT_PUBLIC_BINANCE_API_URL="https://data-api.binance.vision/api/v3"
NEXT_PUBLIC_BINANCE_WS_URL="wss://data-stream.binance.vision/stream"
# Binance futures data (long/short sentiment). Blocked from US server regions.
BINANCE_FUTURES_API_URL="https://fapi.binance.com"

# CoinGecko market data. The key is optional: https://www.coingecko.com/en/api/pricing
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
COINGECKO_API_KEY=""

# Fear & Greed index (no key).
FEAR_GREED_API_URL="https://api.alternative.me"

# News RSS feeds (no key), as comma-separated "Source|url" pairs.
NEWS_RSS_FEEDS="CoinDesk|https://www.coindesk.com/arc/outboundfeeds/rss/,Cointelegraph|https://cointelegraph.com/rss,Decrypt|https://decrypt.co/feed"

# Groq for Raxon AI: https://console.groq.com/keys
GROQ_API_URL="https://api.groq.com/openai/v1"
GROQ_API_KEY=""
# Optional preferred model; the app falls back through gpt-oss-120b, gpt-oss-20b and qwen3.8-27b.
GROQ_MODEL=""
